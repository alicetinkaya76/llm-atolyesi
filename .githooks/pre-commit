#!/bin/sh
# sw.js sürümünü, önbelleğe alınan bir varlık değiştiğinde otomatik damgala.
#
# Neden kanca: service worker varlıkları cache-first veriyor ve tarayıcı yeni
# worker'ı ancak sw.js'in BAYTLARI değiştiğinde kurar. Sürümü elle artırmak
# er ya da geç unutulur (bir kez unutuldu) ve kullanıcı eski JS ile kalır.
set -eu
KOK="$(git rev-parse --show-toplevel)"

# durum.json değişikliği kod değişikliği değildir: her seans damga atmayalım
DEGISEN="$(git diff --cached --name-only --diff-filter=ACM \
  | grep -E '\.(js|css|html)$' | grep -v '^durum\.json$' || true)"
[ -z "$DEGISEN" ] && exit 0

DAMGA="$(date +%Y%m%d-%H%M)"
python3 - "$KOK/sw.js" "$DAMGA" <<'PY'
import re, sys
yol, damga = sys.argv[1], sys.argv[2]
with open(yol, encoding='utf-8') as f:
    s = f.read()
yeni = re.sub(r"const SURUM = '[^']*';", f"const SURUM = 'atolye-{damga}';", s, count=1)
if yeni != s:
    with open(yol, 'w', encoding='utf-8') as f:
        f.write(yeni)
    print(f"sw.js sürümü damgalandı: atolye-{damga}")
PY
git add "$KOK/sw.js"
exit 0
