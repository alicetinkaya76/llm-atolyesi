#!/usr/bin/env node
/* LLM Atölyesi — terminal arayüzü ve durum.json'un TEK YAZICISI.
   Sayfa salt-okunurdur; bu yüzden "tarayıcıdaki taslak ile depodaki durumu
   uzlaştırma" diye bir sorun yok — o sorunu çözen bütün makine (içerik
   imzası, zaman damgası karşılaştırması, geri-al yığını, indir-ve-değiştir
   akışı, token ile yazma) tek yazıcıda hiç doğmuyor.

   Kurulum: ln -sf ~/Desktop/llm-atolyesi/atolye /usr/local/bin/atolye
   Kullanım:
     atolye                  bugün ne açacağım
     atolye f1a 3            basamak ata
     atolye seans            $EDITOR'de seans notu aç
     atolye rapor            son 12 hafta + faz durumu
     atolye liste [faz]      madde kimlikleri
     atolye yayinla          commit + push
     atolye site             yerel sunucu
   Çoğu komut -y ile: kaydet, commit'le, push'la. */
import { readFileSync, writeFileSync, renameSync, existsSync, mkdtempSync, rmSync } from 'node:fs';
import { execFileSync, spawnSync } from 'node:child_process';
import { dirname, join } from 'node:path';
import { fileURLToPath } from 'node:url';
import { tmpdir } from 'node:os';
import {
  tavan, esik, basamakAdlari, fazSayfasi, bugunIso,
  durumOku, basamakAta, hesap, bosDurum
} from './atolye.mjs';

const KOK = dirname(fileURLToPath(import.meta.url));
const DURUM = join(KOK, 'durum.json');
const muf = JSON.parse(readFileSync(join(KOK, 'mufredat.json'), 'utf8'));
const madde = id => muf.items.find(i => i.id === id);
const faz = id => muf.phases.find(p => p.id === id);

function oku() {
  if (!existsSync(DURUM)) return bosDurum();
  try {
    return durumOku(JSON.parse(readFileSync(DURUM, 'utf8')), muf);
  } catch (e) {
    console.error(`HATA: durum.json okunamadı (${e.message}). Elle düzelt.`);
    process.exit(1);
  }
}
/* Atomik yazma. writeFileSync dosyayı önce sıfırlar; yazma yarıda kalırsa
   (disk dolu, Ctrl-C) durum.json 0 bayt kalır ve oku() bozuk JSON'da
   exit(1) yaptığı için ARDINDAN HİÇBİR komut çalışmaz. Aynı dizine yazıp
   rename etmek POSIX'te atomiktir: dosya ya eski ya yeni, asla yarım. */
function yaz(d) {
  const gecici = DURUM + '.tmp';
  writeFileSync(gecici, JSON.stringify(d, null, 1) + '\n', 'utf8');
  renameSync(gecici, DURUM);
}

function git(...a) {
  try {
    return { ok: true, out: execFileSync('git', a, { cwd: KOK, encoding: 'utf8' }).trim() };
  } catch (e) {
    return { ok: false, out: String((e.stderr || e.stdout || e.message)).trim() };
  }
}

/* YALNIZCA durum.json yayınlanır. Her git çağrısı `-- durum.json` yol
   sınırlamasıyla koşar; sınırlama olmadan `git commit -m` o an staged olan
   HER ŞEYİ alır ve push public bir depoya gider — yarım kalmış bir düzenleme
   ya da yanlışlıkla `git add`lenmiş özel bir dosya, "ilerlememi kaydet"
   komutuyla yayımlanmış olurdu. Başka staged dosya varsa dokunulmadığı
   söylenir; sessizce dışarıda bırakmak da bir tür yalan olurdu. */
function yayinla(mesaj) {
  if (!existsSync(join(KOK, '.git'))) return console.log('Not: git deposu değil.');
  git('add', '--', 'durum.json');
  if (git('diff', '--cached', '--quiet', '--', 'durum.json').ok) {
    return console.log('durum.json değişmedi — yayınlanacak bir şey yok.');
  }
  const baskaları = git('diff', '--cached', '--name-only');
  const c = git('commit', '-m', mesaj, '--', 'durum.json');
  if (!c.ok) return console.error('commit başarısız:\n' + c.out);
  const p = git('push');
  console.log(p.ok ? '✓ Yayınlandı.' : 'UYARI: push başarısız (commit yerelde):\n' + p.out);
  if (baskaları.ok) {
    const kalan = baskaları.out.split('\n').map(s => s.trim()).filter(s => s && s !== 'durum.json');
    if (kalan.length) {
      console.log(`Not: bunlar hazırlanmıştı ama commit'e ALINMADI — ${kalan.join(', ')}`);
    }
  }
}

const cubuk = (pct, w = 18) => '█'.repeat(Math.round(w * pct / 100)) + '░'.repeat(w - Math.round(w * pct / 100));
const sa = v => (Math.round(v * 10) / 10).toString();

/* ---------------- komutlar ---------------- */

function bugun(d) {
  const h = hesap(muf, d);
  console.log(`\n${bugunIso()} — bugün ne açacağım?\n`);

  if (h.sonYarin) {
    /* Bağlam sıcakken kendi yazdığın not: sistemdeki tek gerçekten
       ileriye dönük veri. Bu yüzden en üstte. */
    console.log(`  KENDİNE NOT (${h.sonYarin.date})`);
    console.log(`    ${h.sonYarin.yarin}\n`);
  }

  if (h.sonraki) {
    const it = h.sonraki, ad = basamakAdlari(muf, it), n = h.n(it.id);
    console.log(`  SIRADAKİ  [${it.id}] ${it.lbl}`);
    console.log(`            ${ad[n]} → ${ad[h.sonrakiHedef]}`);
    if (h.sonrakiHedef >= tavan(it)) {
      console.log(`            (${faz(it.p).tag} kapısı için bir madde tavana çıkmalı)`);
    }
    if (it.hint) console.log(`            ${it.hint}`);
    console.log(`            plan:  ${fazSayfasi(it.p)}`);
    console.log(`            işle:  atolye ${it.id} ${Math.min(n + 1, h.sonrakiHedef)} -y`);
  } else {
    console.log('  Bütün kapılar geçildi. Kalanlar seçmeli.');
  }

  console.log(`\n  BU HAFTA  ${sa(h.buHafta)} sa · toplam ${sa(h.toplamSaat)} sa / ${h.seans} seans`);
  if (h.gunOldu != null) {
    console.log(`  SON SEANS ${h.gunOldu === 0 ? 'bugün' : h.gunOldu === 1 ? 'dün' : h.gunOldu + ' gün önce'}`);
  }

  const acik = d.journal.filter(e => e.anlamadim).slice(-2);
  if (acik.length) {
    console.log('\n  AÇIK SORULAR');
    for (const e of acik) console.log(`    · ${e.anlamadim}  (${e.date})`);
  }
  console.log();
}

function rapor(d) {
  const h = hesap(muf, d);
  console.log(`\nRapor — ${bugunIso()}`);
  console.log(`Çekirdek %${h.genel} · toplam ${sa(h.toplamSaat)} sa / ${h.seans} seans\n`);

  const seri = h.haftaSaatleri(12);
  const enCok = Math.max(...seri.map(x => x.saat), 1);
  console.log('Son 12 hafta:');
  for (const w of seri) {
    const dolu = Math.round(20 * w.saat / enCok);
    console.log(`  ${w.hafta}  ${'█'.repeat(dolu)}${'·'.repeat(20 - dolu)} ${sa(w.saat).padStart(5)} sa`);
  }

  const esk = h.esikler();
  console.log('\nFazlar (çubuk = fazın çekirdek %\'si · eşik = kapının sağlanabileceği en düşük genel çekirdek %):');
  for (const p of muf.phases) {
    const durum = { gecildi: 'GEÇİLDİ', suruyor: 'sürüyor', baslamadi: 'başlamadı', yok: '—' }[h.kapi(p.id)];
    const e = esk.find(x => x.id === p.id);
    const kalan = h.kapiyaKalan(p.id);
    console.log(`  ${p.tag.padEnd(6)} ${cubuk(h.fazYuzdesi(p.id))} %${String(h.fazYuzdesi(p.id)).padEnd(4)} ` +
      `${durum.padEnd(10)} eşik %${e ? e.pct.toFixed(1) : '—'}` +
      (kalan.length ? ` · kalan: ${kalan.map(x => x.it.id + '→' + x.hedef).join(', ')}` : ''));
  }

  const ogr = d.journal.filter(e => e.ogrendim).slice(-5);
  if (ogr.length) {
    console.log('\nSon öğrendiklerin:');
    for (const e of ogr) console.log(`  · ${e.ogrendim}  (${e.date})`);
  }
  console.log();
}

function liste(d, fid) {
  const h = hesap(muf, d);
  if (fid && !faz(fid)) {
    console.error(`Böyle bir faz yok: ${fid}\nFazlar: ${muf.phases.map(p => p.id).join(', ')}`);
    process.exit(1);
  }
  for (const p of muf.phases) {
    if (fid && p.id !== fid) continue;
    console.log(`\n${p.tag} — ${p.name}`);
    for (const it of h.fazMaddeleri(p.id)) {
      const ad = basamakAdlari(muf, it), n = h.n(it.id);
      console.log(`  [${it.id.padEnd(4)}] ${it.core ? 'Ç' : ' '} ${n}/${tavan(it)} ${ad[n].padEnd(22)} ${it.lbl}`);
    }
  }
  console.log();
}

const ALANLAR = ['saat', 'yaptim', 'ogrendim', 'anlamadim', 'yarin'];

/* Şablon ayrıştırıcı. Üç kural, üçü de bir kez kaybedilmiş nottan öğrenildi:
   · \r kırpılır — CRLF ile kaydeden bir düzenleyicide (VS Code files.eol,
     vim fileformat=dos) `$` satır sonundaki \r'yi eşleştiremez ve TEK BİR
     alan bile yakalanmazdı: dolu bir not "boş seans" sayılıp siliniyordu.
   · girintili devam satırları bir öncekine eklenir — $EDITOR çok satırlı
     yazmaya davet eder; sessizce kırpmak veri kaybıdır.
   · şablonda yalnız kaydedilen alanlar sorulur (eski `faz:` alanı hiçbir
     yere yazılmıyordu; sorup atmak arayüzün yalanıydı). */
function sablonCoz(metin) {
  const alan = {};
  let son = null;
  for (const ham of metin.split('\n')) {
    const satir = ham.replace(/\r$/, '');
    if (satir.trim().startsWith('#')) continue;
    const m = satir.match(/^([a-z]+):[ \t]*(.*)$/);
    if (m && ALANLAR.includes(m[1])) {
      son = m[1];
      alan[son] = m[2].trim();
    } else if (son && satir.trim()) {
      alan[son] = (alan[son] ? alan[son] + ' ' : '') + satir.trim();
    }
  }
  return alan;
}

function seansEkle(d, yay) {
  /* git commit kalıbı: şablonu $EDITOR'de aç, yorum satırlarını at.
     Tarayıcıda bir form ve onun senkron makinesi yerine ~20 satır. */
  const sablon =
`# LLM Atölyesi — seans notu. Yorum satırları (#) yok sayılır.
# Girintili satırlar bir üstteki alanın devamı sayılır.
# Hepsini boş bırakırsan seans kaydedilmez.
saat:
yaptim:
ogrendim:
anlamadim:
yarin:
`;
  const dizin = mkdtempSync(join(tmpdir(), 'atolye-'));
  const yol = join(dizin, 'SEANS');
  writeFileSync(yol, sablon, 'utf8');

  /* $EDITOR argüman taşıyabilir: "code --wait", "subl -w", "emacsclient -nw". */
  const ham = (process.env.VISUAL || process.env.EDITOR || 'nano').trim();
  const parca = ham.split(/\s+/);
  const r = spawnSync(parca[0], [...parca.slice(1), yol], { stdio: 'inherit' });
  if (r.error) {
    console.error(`Düzenleyici açılamadı (${ham}): ${r.error.message}`);
    console.error(`Not şurada duruyor: ${yol}`);
    return;
  }

  const metin = readFileSync(yol, 'utf8');
  const alan = sablonCoz(metin);
  const saat = parseFloat(String(alan.saat || '').replace(',', '.')) || 0;

  /* Kayıt kapısı BÜTÜN alanlara bakar. Eskiden yalnız saat+yaptim'e
     bakıyordu; saat girmeyi unutup sadece "yarın ilk iş"i yazan kullanıcının
     notu — panonun en üstte gösterdiği tek ileriye dönük veri — sessizce
     çöpe gidiyordu. Ve geçici dosya ayrıştırmadan önce silindiği için
     metnin tek kopyası da yok oluyordu; artık yalnız kayıt başarılıysa
     siliniyor. */
  const doluMu = saat > 0 || ALANLAR.some(a => a !== 'saat' && alan[a]);
  if (!doluMu) {
    rmSync(dizin, { recursive: true, force: true });
    return console.log('Boş seans — kaydedilmedi.');
  }

  /* Durumu editörden SONRA yeniden oku. Not yazmak dakikalar sürebilir;
     bu arada başka bir terminalde `atolye f1a 3` koşulduysa, süreç başında
     alınmış anlık görüntüyü geri yazmak o basamağı siler. Tek yazıcı
     kendisiyle de yarışabilir. */
  const taze = oku();
  taze.journal.push({
    date: bugunIso(), hours: saat,
    yaptim: alan.yaptim || '', ogrendim: alan.ogrendim || '',
    anlamadim: alan.anlamadim || '', yarin: alan.yarin || ''
  });
  yaz(taze);
  rmSync(dizin, { recursive: true, force: true });
  console.log(`Seans kaydedildi: ${sa(saat)} sa. Bu hafta ${sa(hesap(muf, taze).buHafta)} sa.`);
  if (yay) yayinla(`seans: ${bugunIso()} (${sa(saat)} sa)` + (alan.yaptim ? ` — ${alan.yaptim.slice(0, 60)}` : ''));
}

/* ---------------- yönlendirme ---------------- */
const argv = process.argv.slice(2);
const yay = argv.includes('-y') || argv.includes('--yayinla');
const arg = argv.filter(a => a !== '-y' && a !== '--yayinla');
const d = oku();

const komut = arg[0];

if (!komut) {
  bugun(d);
} else if (komut === 'rapor') {
  rapor(d);
} else if (komut === 'liste') {
  liste(d, arg[1]);
} else if (komut === 'seans') {
  seansEkle(d, yay);
} else if (komut === 'yayinla') {
  yayinla(arg[1] || `defter: ${bugunIso()}`);
} else if (komut === 'site') {
  spawnSync(process.execPath, [join(KOK, 'serve.mjs')], { stdio: 'inherit' });
} else if (madde(komut)) {
  /* atolye f1a 3 — anahtar kelime yok, doğrudan madde */
  const it = madde(komut);
  const n = parseInt(arg[1], 10);
  if (!(n >= 0 && n <= tavan(it))) {
    console.error(`HATA: ${it.id} için basamak 0–${tavan(it)} arası olmalı.`);
    process.exit(1);
  }
  if (!basamakAta(d, it, n)) {
    console.log(`${it.lbl} zaten ${n}. basamakta.`);
  } else {
    yaz(d);
    const ad = basamakAdlari(muf, it);
    console.log(`${it.lbl} → ${n} (${ad[n]})`);
    const h = hesap(muf, d);
    if (h.kapi(it.p) === 'gecildi') console.log(`🎉 ${faz(it.p).tag} kapısı geçildi.`);
    if (yay) yayinla(`defter: ${it.id} → ${n} (${ad[n]})`);
  }
} else {
  console.error(`Bilinmeyen komut: ${komut}\n` +
    'atolye | atolye <madde> <basamak> | atolye seans | atolye rapor | atolye liste [faz] | atolye yayinla | atolye site');
  process.exit(1);
}
